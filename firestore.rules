rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // KinTree Archival Vault rules
    match /vaults/{vaultId} {
      allow read, write: if true; // Test/development mode; can be restricted to request.auth != null
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
